{
  "name": "decky-emudeck-romm",
  "version": "0.0.0",
  "description": "Decky Loader plugin that turns a RomM server into a library for an EmuDeck install",
  "type": "module",
  "private": true,
  "license": "GPL-3.0",
  "author": "chenasraf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenasraf/decky-emudeck-romm.git"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate": "cd backend && go generate ./..."
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode.react": "^4.2.0",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@rollup/rollup-linux-x64-musl": "^4.64.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
